# Rust build artifacts
/target

# Downloaded OS images (large binaries, not source)
/images/*.iso
/images/*.bin
/images/vmlinuz*
/images/initramfs*
# Symbol table extracted from a kernel image (derived; regenerate with
# tools/kallsyms.py)
/images/*.syms

# Scratch debugging scripts used while chasing the Linux boot
/images/dump*.py
/images/parse*.py
/images/findstart.py
/images/disasm.py
/images/ph.py
/images/walk_pg.py
/images/compare*.py
/images/elfinfo.py
/images/layout.py

# Trace output and memory dumps at the repo root
/trace.txt
/*.bin

# Scratch files at the repo root
/analysis*.txt
/cr0lines.txt
/parse_pgdir.py